# Variables del sitio WAS ON (Netlify: Site settings -> Environment variables)

# Proyecto de Supabase que guarda usuarios y plano.
SUPABASE_URL=https://<ref>.supabase.co
# Clave secreta (service role). Solo la usan las funciones del servidor:
# nunca debe llegar al navegador.
SUPABASE_SECRET_KEY=

# Firma de la cookie de sesion. Minimo 32 caracteres.
# Generar con: openssl rand -base64 48
SESSION_SECRET=

# Administrador inicial. Solo sirve mientras la tabla de usuarios este vacia:
# con el primer inicio de sesion el usuario queda creado y estas variables
# dejan de tener efecto.
WAS_ON_ADMIN_USERNAME=ON
WAS_ON_ADMIN_PASSWORD=
